{
	"name": "@mheob/changeset-changelog",
	"version": "3.0.2",
	"description": "My personal changeset changelog configuration.",
	"keywords": [
		"changelog",
		"changeset",
		"config"
	],
	"homepage": "https://github.com/mheob/changeset-changelog",
	"bugs": "https://github.com/mheob/changeset-changelog/issues",
	"license": "MIT",
	"author": "Alexander Böhm <tools@boehm.work>",
	"repository": {
		"type": "git",
		"url": "https://github.com/mheob/changeset-changelog"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "vp pack",
		"changeset": "changeset",
		"check": "vp check",
		"check:catalog": "node scripts/check-catalog.ts",
		"check:vite-plus": "node scripts/check-vite-plus-versions.ts",
		"commit": "czg",
		"dev": "vp pack --watch",
		"prepare": "vp config",
		"release": "changeset publish",
		"test": "vp test",
		"version-packages": "changeset version && vp fmt package.json"
	},
	"dependencies": {
		"@changesets/get-github-info": "catalog:",
		"@changesets/types": "catalog:"
	},
	"devDependencies": {
		"@changesets/cli": "catalog:",
		"@commitlint/cli": "catalog:",
		"@mheob/commitlint-config": "catalog:",
		"@mheob/oxfmt-config": "catalog:",
		"@mheob/oxlint-config": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"czg": "catalog:",
		"eslint-plugin-regexp": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": ">=24.21.0"
	},
	"packageManager": "pnpm@12.23.0"
}
